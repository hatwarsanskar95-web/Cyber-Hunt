# ==============================================================================
# CYBER HUNT — Environment Configuration Template
# Copy this file to .env (for backend) and frontend/.env.local (for frontend)
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# --- Google Gemini AI API Configuration ---
# Your Google Gemini API Key from Google AI Studio (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
# Approved primary AI model (Gemini 3.8 Flash)
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase Database & Auth Configuration ---
# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Anon / Publishable Key (client-safe)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Supabase Service-Role Key (CRITICAL: SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Direct PostgreSQL connection string for backend repositories
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# --- Open Policy Agent (OPA) Configuration ---
# Local Windows OPA executable HTTP endpoint (default: http://localhost:8181)
OPA_URL=http://localhost:8181

# --- Frontend Next.js Public Client Configuration ---
# FastAPI Backend REST endpoint reachable by the Next.js browser client
NEXT_PUBLIC_API_URL=http://localhost:8001
# FastAPI Backend WebSocket live event stream endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/v1/ws

# --- Google OAuth 2.0 (Gmail Read-Only Integration) ---
# Google OAuth 2.0 Client credentials (server-side only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/gmail/callback
# Google Cloud Pub/Sub configuration for real-time push notifications (optional)
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=your_pubsub_token_here

# --- VirusTotal Security API ---
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# --- Local Demo Safeguards ---
# Enable unauthenticated demo access restricted strictly to loopback 127.0.0.1 in development
LOCAL_DEMO_MODE=true
